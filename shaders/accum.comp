#version 460
// Temporal accumulation for the path tracer, with reprojection so the image stays stable while moving.

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0, rgba16f) uniform readonly image2D hdr;
layout(set = 0, binding = 1) uniform sampler2D depthTex;
layout(set = 0, binding = 2, rgba32f) uniform readonly image2D histIn;
layout(set = 0, binding = 3, r32f) uniform readonly image2D distIn;
layout(set = 0, binding = 4, rgba32f) uniform writeonly image2D histOut;
layout(set = 0, binding = 5, r32f) uniform writeonly image2D distOut;

layout(push_constant) uniform PC {
    mat4 invViewProj;
    mat4 prevViewProj;
    vec4 camDelta;  // xyz: current camera - previous camera, w: reset history
} pc;

const float MAX_FRAMES = 96.0;

void main() {
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(hdr);
    if (any(greaterThanEqual(px, size))) return;

    vec3 cur = imageLoad(hdr, px).rgb;
    float d = texelFetch(depthTex, px, 0).r;
    if (d <= 0.0 || pc.camDelta.w > 0.5) {
        imageStore(histOut, px, vec4(cur, 1.0));
        imageStore(distOut, px, vec4(d <= 0.0 ? -1.0 : 0.0));
        return;
    }

    vec2 uv = (vec2(px) + 0.5) / vec2(size);
    vec4 w = pc.invViewProj * vec4(uv * 2.0 - 1.0, d, 1.0);
    vec3 p = w.xyz / w.w;
    vec3 prevP = p + pc.camDelta.xyz;
    float dist = length(prevP);

    vec4 clip = pc.prevViewProj * vec4(prevP, 1.0);
    vec2 prevUV = clip.xy / clip.w * 0.5 + 0.5;
    ivec2 prevPx = ivec2(prevUV * vec2(size));
    vec4 result = vec4(cur, 1.0);
    if (clip.w > 0.0 && all(greaterThanEqual(prevPx, ivec2(0))) && all(lessThan(prevPx, size))) {
        float prevDist = imageLoad(distIn, prevPx).r;
        if (abs(prevDist - dist) < 0.03 * dist + 0.05) {
            vec4 h = imageLoad(histIn, prevPx);
            float n = min(h.a + 1.0, MAX_FRAMES);
            result = vec4(mix(h.rgb, cur, 1.0 / n), n);
        }
    }
    imageStore(histOut, px, result);
    imageStore(distOut, px, vec4(length(p)));
}
